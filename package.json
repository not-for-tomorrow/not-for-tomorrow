{
  "name": "superapp-portfolio-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:fe": "npm --prefix FE run dev",
    "dev:mobile": "npm --prefix Mobile run web",
    "dev:windows": "npm --prefix Windows run start",
    "dev:py": "cd Py && .\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "dev:be": "cd BE && mvn spring-boot:run",
    "dev:core": "concurrently \"npm run dev:fe\" \"npm run dev:py\"",
    "dev:all": "concurrently \"npm run dev:fe\" \"npm run dev:py\" \"npm run dev:mobile\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

